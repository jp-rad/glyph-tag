<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ========================================================= -->
    <!-- GlyphSet: Search View                                     -->
    <!-- ========================================================= -->
    <record id="view_search_glyph_set" model="ir.ui.view">
        <field name="name">joo_mjrengo.glyph_set.search</field>
        <field name="model">joo_mjrengo.glyph_set</field>
        <field name="arch" type="xml">
            <search string="Search Glyph Sets">
                <!-- Basic fields -->
                <field name="name"/>
                <field name="description"/>

                <!-- OR search: name OR description -->
                <filter string="Name or Description"
                        name="name_or_description"
                        domain="['|', ('name', 'ilike', self), ('description', 'ilike', self)]"/>
            </search>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- GlyphSet: List View                                       -->
    <!-- ========================================================= -->
    <record id="view_list_glyph_set" model="ir.ui.view">
        <field name="name">joo_mjrengo.glyph_set.list</field>
        <field name="model">joo_mjrengo.glyph_set</field>
        <field name="arch" type="xml">
            <list string="Glyph Sets">
                <field name="name"/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- GlyphSet: Form View                                       -->
    <!-- ========================================================= -->
    <record id="view_form_glyph_set" model="ir.ui.view">
        <field name="name">joo_mjrengo.glyph_set.form</field>
        <field name="model">joo_mjrengo.glyph_set</field>
        <field name="arch" type="xml">
            <form string="Glyph Set">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                    </group>

                    <group string="Glyph Entries">
                        <field name="entry_ids">
                            <list editable="bottom">
                                <field name="name"/>
                                <field name="ucs"/>
                                <field name="rep"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ========================================================= -->
    <!-- Action                                                     -->
    <!-- ========================================================= -->
    <record id="action_glyph_set" model="ir.actions.act_window">
        <field name="name">Glyph Sets</field>
        <field name="res_model">joo_mjrengo.glyph_set</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_search_glyph_set"/>
    </record>

    <!-- ========================================================= -->
    <!-- Menu                                                      -->
    <!-- ========================================================= -->
    <menuitem id="menu_glyph_root" name="Glyph System"/>
    <menuitem id="menu_glyph_set"
              parent="menu_glyph_root"
              action="action_glyph_set"
              name="Glyph Sets"/>

</odoo>
