<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.joo_mjrengo</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <app string="MJ-Rengo" data-string="joo_mjrengo" name="joo_mjrengo">

                    <!-- Glyph System block -->
                    <block title="Glyph System">
                        <setting id="joo_set_setting"
                                 help="Select the glyph set used for glyph tag normalization.">
                            <field name="joo_set"/>
                        </setting>

                        <setting id="joo_font_setting"
                                 help="Select the font applied to elements using the 'joo-font' class.">
                            <field name="joo_font"/>
                        </setting>
                    </block>

                </app>
            </xpath>

        </field>
    </record>
</odoo>
