<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.joo_mjrengo</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <app string="Joo MJ Rengo" data-string="JooMjRengo" name="joo_mjrengo">

                    <!-- Glyph System block -->
                    <block title="Glyph System">
                        <setting id="joo_glyph_set_setting"
                                 help="GlyphSet（字形体系）を指定します。">
                            <field name="joo_glyph_set_id"/>
                        </setting>
                        <setting id="joo_font_setting"
                                 help="class='joo-font'に適用されるフォントを指定します。">
                            <field name="joo_font"/>
                        </setting>
                    </block>

                </app>
            </xpath>

        </field>
    </record>
</odoo>
