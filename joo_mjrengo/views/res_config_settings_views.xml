<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.joo_mjrengo</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="90"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="JooMjRengo" data-string="JooMjRengo" name="joo_mjrengo">
                    <block title="Fonts">
                        <setting id="joo_font_setting"
                                 help="フォントを指定します。">
                            <field name="joo_font"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
